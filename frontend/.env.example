# Gerçek değerler .env dosyasında; .env commit'lenmez.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# sb_publishable_ ile BAŞLAR. Bu anahtar tasarımı gereği herkese açıktır;
# güvenliği erişim kurallarından (RLS) gelir, gizliliğinden değil.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# sb_secret_ anahtarı ve eski service_role anahtarı BURAYA VE HİÇBİR
# frontend dosyasına GİRMEZ. Onları isteyen bir adım yanlış yazılmıştır.

# Backend adresi. Yazilmazsa dev'de Metro'nun hostUri'sinden
# LAN adresi turetilir. Tunel kuruluysa tunel adresi yazilir.
EXPO_PUBLIC_BACKEND_URL=https://api.ornek-alan-adi.com
