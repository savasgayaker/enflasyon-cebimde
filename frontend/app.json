{
  "expo": {
    "name": "Enflasyon Cebimde",
    "slug": "enflasyon-cebimde",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "enflasyon-cebimde",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.savasgayaker.enflasyoncebimde",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Fişlerinizi okuyabilmek için kameraya erişim gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Galerinizden fiş fotoğrafı seçebilmek için izin gerekiyor.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.savasgayaker.enflasyoncebimde",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D9488"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Fişlerinizi okuyabilmek için kameraya erişim gerekiyor.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Galerinizden fiş fotoğrafı seçebilmek için izin gerekiyor."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D9488"
        }
      ],
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05d092a1-1f57-4b65-b8c9-b9ea3801bf94"
      }
    },
    "owner": "gayaker"
  }
}
