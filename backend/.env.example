# MiniMax M3 API anahtarı — /api/parse-receipt için ZORUNLU.
# Gerçek anahtarı backend/.env dosyasına yazın (.env git'e girmez).
MINIMAX_API_KEY=buraya-anahtar

# Supabase proje adresi — jeton doğrulaması için ZORUNLU.
# frontend/.env içindeki EXPO_PUBLIC_SUPABASE_URL ile AYNI değer.
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Kullanıcı başına üst sınırlar (opsiyonel; varsayılanlar 60 / 200).
# PARSE_LIMIT_HOUR=60
# PARSE_LIMIT_DAY=200

# ESKİ Supabase projeleri için simetrik JWT sırrı. Yeni projede TANIMSIZ
# BIRAKILIR — tanımlanırsa sunucu asimetrik doğrulamayı kapatır.
# SUPABASE_JWT_SECRET=

# MongoDB OPSİYONEL — tanımlı değilse /api/status endpoint'leri 503 döner,
# /api/parse-receipt etkilenmez.
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=enflasyon
